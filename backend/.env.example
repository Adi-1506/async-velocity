NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/async-standup-bot
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Configure only for an exact, trusted reverse-proxy topology.
TRUST_PROXY_HOPS=
# Enable these for production after configuring email.
REQUIRE_EMAIL_VERIFICATION=false
CHECK_BREACHED_PASSWORDS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Bootstrap once; remove the password afterwards.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

REQUIRE_BOT_PROTECTION=false
TURNSTILE_SECRET_KEY=

MIGRATION_MONGO_URI=
BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
BACKUP_DB_NAME=
RESTORE_DB_NAME=
RESTORE_MONGO_URI=
RESTORE_CONFIRM=

# Public disclosure contact, served by the frontend; set these there too.
SECURITY_CONTACT=
SECURITY_EXPIRES=
