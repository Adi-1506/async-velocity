# Copy to .env only on the deployment host. Never commit populated values.
# One public origin for browser, API and sockets; no trailing slash.
APP_DOMAIN=
ACME_EMAIL=
NODE_ENV=production
CLIENT_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
TRUST_PROXY_HOPS=1
MONGO_URI=
MFA_ENCRYPTION_KEY=
REQUIRE_EMAIL_VERIFICATION=true
CHECK_BREACHED_PASSWORDS=true
REQUIRE_BOT_PROTECTION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SECURITY_CONTACT=
SECURITY_EXPIRES=
# Keep backup credentials and encryption key on the separate backup host.
